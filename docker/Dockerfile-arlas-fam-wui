### STAGE 1: Build ###

# We label our stage as 'builder'
FROM node:24.2.0-slim AS builder
WORKDIR /app

COPY ./angular/file-explorer/package.json  ./
COPY ./angular/file-explorer/package-lock.json  ./

## installing necessary libraries
RUN npm install --ignore-scripts && npm run postinstall

COPY ./angular/file-explorer/scripts/start.sh ./

COPY ./angular/file-explorer .

## Build the angular app in production mode
RUN npm run build

### STAGE 2: Setup ###

FROM nginx:1.29-alpine3.23-slim
ARG version="0.0"
ENV AIAS_VERSION=${version}

LABEL io.arlas.wui-fam.version=${version}
LABEL vendor="Gisaïa"
LABEL description="This container serves the FAM-wui app"

RUN apk add  --no-cache --update bash jq netcat-openbsd curl && rm -rf /var/cache/apk/* && apk add 'libxml2==2.13.9-r0' 'zlib==1.3.2-r0'


## Remove default nginx website
RUN chown -R nginx /etc/nginx && \
    chown -R nginx /usr/share/nginx/html  && \
    chown -R nginx /var/cache/nginx

## Copy our default nginx config
COPY ./angular/file-explorer/nginx/default.conf /etc/nginx/conf.d/
COPY ./angular/file-explorer/nginx/nginx.conf /etc/nginx/nginx.conf

## From 'builder' stage copy over the artifacts in dist folder to default nginx public folder
COPY --from=builder /app/dist/file-explorer /usr/share/nginx/html
COPY --from=builder /app/start.sh /usr/share/nginx/

## Fix permissions for template filling at container startup
## Nginx user must be able to set variables in these files
RUN touch /usr/share/nginx/html/settings.yaml.tmp && \
    touch /etc/nginx/conf.d/default.conf.tmp && \
    touch /usr/share/nginx/html/index.html.tmp &&  \
    chmod 666 /usr/share/nginx/html/settings.yaml.tmp \
        /usr/share/nginx/html/settings.yaml \
        /etc/nginx/conf.d/default.conf.tmp \
        /etc/nginx/conf.d/default.conf \
        /usr/share/nginx/html/index.html.tmp \
        /usr/share/nginx/html/index.html

USER nginx

HEALTHCHECK CMD curl --fail http://localhost:8080/ || exit 1

ENTRYPOINT ["/usr/share/nginx/start.sh"]